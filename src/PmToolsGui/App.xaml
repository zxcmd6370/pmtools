<Application
    x:Class="PmToolsGui.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:PmToolsGui"
    ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- PmTools Blue Palette -->
            <Color x:Key="PmBlue">#1A6FB5</Color>
            <Color x:Key="PmBlueDark">#144E82</Color>
            <Color x:Key="PmBlueLight">#5DADE2</Color>
            <Color x:Key="PmBluePale">#D6EAF8</Color>
            <Color x:Key="PmBackground">#EBF5FB</Color>
            <Color x:Key="PmSurface">#FFFFFF</Color>
            <Color x:Key="PmText">#1A2C42</Color>
            <Color x:Key="PmTextMuted">#5D8AA8</Color>

            <SolidColorBrush x:Key="PmBlueBrush" Color="#1A6FB5"/>
            <SolidColorBrush x:Key="PmBlueDarkBrush" Color="#144E82"/>
            <SolidColorBrush x:Key="PmBlueLightBrush" Color="#5DADE2"/>
            <SolidColorBrush x:Key="PmBluePaleBrush" Color="#D6EAF8"/>
            <SolidColorBrush x:Key="PmBackgroundBrush" Color="#EBF5FB"/>
            <SolidColorBrush x:Key="PmSurfaceBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="PmTextBrush" Color="#1A2C42"/>
            <SolidColorBrush x:Key="PmTextMutedBrush" Color="#5D8AA8"/>

            <!-- Override WPF-UI accent to PmTools blue -->
            <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush" Color="#1A6FB5"/>
            <SolidColorBrush x:Key="SystemAccentColorSecondaryBrush" Color="#5DADE2"/>
            <SolidColorBrush x:Key="SystemAccentColorTertiaryBrush" Color="#D6EAF8"/>

            <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
            <local:NullToCollapsedConverter x:Key="NullToCollapsed" />
            <local:StatusToBrushConverter x:Key="StatusToBrush" />
            <local:ImagePathToSourceConverter x:Key="ImagePathToSource" />
            <local:EqualityMultiConverter x:Key="EqualityMulti" />
            <local:MinHeightToVisibilityConverter x:Key="MinHeightToVis" />
            <local:FilterOptionDisplayConverter x:Key="FilterOptionDisplay" />
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
