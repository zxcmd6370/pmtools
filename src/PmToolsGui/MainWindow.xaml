<ui:FluentWindow
    x:Class="PmToolsGui.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:PmToolsGui.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:PmToolsGui.ViewModels"
    xmlns:views="clr-namespace:PmToolsGui.Views"
    Title="PmTools"
    Icon="icon.ico"
    Width="1080"
    Height="720"
    MinWidth="760"
    MinHeight="560"
    Background="#EBF5FB"
    d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar with blue tint -->
        <ui:TitleBar Grid.Row="0" Title="PmTools" Background="#1A6FB5" Foreground="White">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/icon.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1" Background="#EBF5FB">
            <Grid x:Name="AppContent">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Onboarding.IsOpen}" Value="True">
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <BlurEffect KernelType="Gaussian" Radius="28" RenderingBias="Performance" />
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <ui:NavigationView
                    x:Name="RootNavigation"
                    IsBackButtonVisible="Collapsed"
                    IsPaneToggleVisible="False"
                    OpenPaneLength="190"
                    PaneDisplayMode="Left">

                    <ui:NavigationView.MenuItems>
                        <ui:NavigationViewItem Content="{x:Static res:Strings.Nav_Home}" TargetPageType="{x:Type views:HomeView}">
                            <ui:NavigationViewItem.Icon>
                                <ui:SymbolIcon Symbol="Home24" Foreground="#1A6FB5"/>
                            </ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem Content="{x:Static res:Strings.Nav_Add}" TargetPageType="{x:Type views:DownloadView}">
                            <ui:NavigationViewItem.Icon>
                                <ui:SymbolIcon Symbol="Add24" Foreground="#1A6FB5"/>
                            </ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem Content="{x:Static res:Strings.Nav_Manage}" TargetPageType="{x:Type views:ManageView}">
                            <ui:NavigationViewItem.Icon>
                                <ui:SymbolIcon Symbol="Games24" Foreground="#1A6FB5"/>
                            </ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem Content="{x:Static res:Strings.Nav_Builds}" TargetPageType="{x:Type views:BuildsView}">
                            <ui:NavigationViewItem.Icon>
                                <ui:SymbolIcon Symbol="BranchFork24" Foreground="#1A6FB5"/>
                            </ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem Content="{x:Static res:Strings.Nav_Mode}" TargetPageType="{x:Type views:ModeView}">
                            <ui:NavigationViewItem.Icon>
                                <ui:SymbolIcon Symbol="Options24" Foreground="#1A6FB5"/>
                            </ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem Content="{x:Static res:Strings.Nav_Fixes}" TargetPageType="{x:Type views:FixesView}">
                            <ui:NavigationViewItem.Icon>
                                <ui:SymbolIcon Symbol="ShieldTask24" Foreground="#1A6FB5"/>
                            </ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem Content="Plugin" TargetPageType="{x:Type views:PluginView}">
                            <ui:NavigationViewItem.Icon>
                                <ui:SymbolIcon Symbol="PuzzlePiece24" Foreground="#1A6FB5"/>
                            </ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                    </ui:NavigationView.MenuItems>

                    <ui:NavigationView.FooterMenuItems>
                        <ui:NavigationViewItem Content="{x:Static res:Strings.Nav_RestartSteam}" Click="RestartSteam_Click">
                            <ui:NavigationViewItem.Icon>
                                <ui:SymbolIcon Symbol="ArrowClockwise24" Foreground="#1A6FB5"/>
                            </ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem Content="{x:Static res:Strings.Nav_Downloads}" TargetPageType="{x:Type views:DownloadsView}">
                            <ui:NavigationViewItem.Icon>
                                <ui:SymbolIcon Symbol="ArrowDownload24" Foreground="#1A6FB5"/>
                            </ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem Content="{x:Static res:Strings.Nav_Settings}" TargetPageType="{x:Type views:SettingsView}">
                            <ui:NavigationViewItem.Icon>
                                <ui:SymbolIcon Symbol="Settings24" Foreground="#1A6FB5"/>
                            </ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                    </ui:NavigationView.FooterMenuItems>

                    <!-- Pane footer: sign-in + version -->
                    <ui:NavigationView.PaneFooter>
                        <StackPanel>
                            <!-- Logo area -->
                            <Border Margin="10,8,10,4" Background="#D6EAF8" CornerRadius="8" Padding="8,6">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Ellipse Width="22" Height="22">
                                        <Ellipse.Fill>
                                            <ImageBrush ImageSource="pack://application:,,,/icon.ico"/>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
                                               FontWeight="Bold" FontSize="13"
                                               Foreground="#1A6FB5" Text="PmTools"/>
                                </StackPanel>
                            </Border>

                            <StackPanel
                                Margin="10,4,10,8"
                                Visibility="{Binding IsGuest, Converter={StaticResource BoolToVis}}">
                                <ui:Button
                                    HorizontalAlignment="Stretch"
                                    Appearance="Primary"
                                    Command="{Binding SignInCommand}"
                                    Content="{x:Static res:Strings.Nav_SignInDiscord}"
                                    Icon="{ui:SymbolIcon Person24}"
                                    Visibility="{Binding IsSigningIn, Converter={StaticResource InverseBoolToVis}}" />
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    Orientation="Horizontal"
                                    Visibility="{Binding IsSigningIn, Converter={StaticResource BoolToVis}}">
                                    <ui:ProgressRing Width="16" Height="16" IsIndeterminate="True" />
                                    <TextBlock
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="11.5"
                                        Foreground="#5D8AA8"
                                        Text="{x:Static res:Strings.Nav_WaitingForBrowser}" />
                                </StackPanel>
                                <TextBlock
                                    Margin="2,8,0,0"
                                    FontSize="11.5"
                                    Foreground="#f87171"
                                    Text="{Binding SignInError}"
                                    TextWrapping="Wrap"
                                    Visibility="{Binding SignInError, Converter={StaticResource NullToCollapsed}}" />
                            </StackPanel>

                            <TextBlock
                                Margin="12,0,10,8"
                                FontSize="11"
                                Foreground="#5D8AA8"
                                Text="{Binding FooterStatus}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="{Binding FooterStatus}" />
                        </StackPanel>
                    </ui:NavigationView.PaneFooter>
                </ui:NavigationView>

                <ui:SnackbarPresenter
                    x:Name="RootSnackbar"
                    Margin="0,0,24,18"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom" />
            </Grid>

            <views:OnboardingView
                DataContext="{Binding Onboarding}"
                Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}" />
        </Grid>
    </Grid>
</ui:FluentWindow>
